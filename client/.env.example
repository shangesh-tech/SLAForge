# Copy to .env.local
# Arc network: "mainnet" or "testnet". If unset, a testnet RPC URL means testnet.
NEXT_PUBLIC_ARC_NETWORK=mainnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
# Your deployed SLAForge contract on that network
NEXT_PUBLIC_SLAFORGE_ADDRESS=

# Server-only (never prefix with NEXT_PUBLIC_)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=slaforge
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# SLA monitor bot. Set its address on the contract with setMonitor(address).
MONITOR_PRIVATE_KEY=
# Bearer token for /api/monitor/tick (external cron on serverless hosts)
CRON_SECRET=
# Set to "false" to stop the built-in 2-minute scheduler
# MONITOR_AUTORUN=false
# How often the monitor runs, in seconds (default 120 = 2 minutes; use 10 for quick testing)
# MONITOR_INTERVAL_SECONDS=120
