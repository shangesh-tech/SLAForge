# Copy to .env and fill in. Never commit .env.

# --- Arc network ---
# "mainnet" or "testnet"
ARC_NETWORK=mainnet
# Your RPC (Alchemy etc.). Defaults to the public Arc RPC for ARC_NETWORK.
ARC_RPC_URL=https://rpc.mainnet.arc.io
# The deployed SLAForge contract
SLAFORGE_ADDRESS=0x24FB87247f850854A1520D4FA13c703FAc68692A

# --- MongoDB (the same database the web app uses) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=slaforge

# --- Monitor wallet ---
# Private key of the contract's monitor() address. Keep a little USDC on it for gas.
# Without it the service still records health checks but cannot settle.
MONITOR_PRIVATE_KEY=

# --- Schedule ---
# How often to check services and settle agreements, in seconds (default 120)
MONITOR_INTERVAL_SECONDS=120
# Set to false to run only when POST /tick is called
MONITOR_AUTORUN=true

# --- HTTP ---
PORT=4000
HOST=0.0.0.0
# Protects POST /tick (manual run). Generate with: openssl rand -hex 24
CRON_SECRET=
